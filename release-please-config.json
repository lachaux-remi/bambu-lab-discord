{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "pull-request-title-pattern": "chore${scope}: release ${version}",
  "pull-request-header": ":robot: Cette pull request prépare la prochaine release.",
  "pull-request-footer": "Cette pull request a été générée par [Release Please](https://github.com/googleapis/release-please). Ne remplacez pas son corps : conservez les séparateurs `---` et le bloc généré entre eux afin que la release puisse être taguée après fusion.",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Fonctionnalités"
    },
    {
      "type": "fix",
      "section": "Corrections de bugs"
    },
    {
      "type": "perf",
      "section": "Améliorations des performances"
    },
    {
      "type": "revert",
      "section": "Annulations"
    },
    {
      "type": "chore",
      "section": "Maintenance",
      "hidden": true
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Style",
      "hidden": true
    },
    {
      "type": "refactor",
      "section": "Refactorisation du code",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Système de build",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Intégration continue",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "include-component-in-tag": false,
      "release-type": "node"
    }
  }
}
